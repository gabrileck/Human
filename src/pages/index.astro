---
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Preloader from '../components/Preloader.astro';
import Hero from '../components/Hero.jsx';
import Dobra3D from '../components/Dobra3D.jsx';
import Metodo from '../components/Metodo.jsx';
import Palco from '../components/Palco.jsx';

import parede from '../assets/hero/parede.webp';
import estante from '../assets/hero/estante.webp';
import homem from '../assets/hero/homem.webp';
import mulher from '../assets/hero/mulher.webp';

/*
	Imagens da 1ª dobra geradas no build: AVIF (bem menor) com WebP de reserva,
	em 3 larguras — o celular baixa a pequena, a tela grande baixa a grande.
*/
const WIDTHS = [640, 960, 1254];
const PEOPLE_SIZES = '(max-width: 900px) min(104vw, 560px), min(64vw, 112vh)';

async function responsive(src: ImageMetadata, sizes: string) {
	const [avif, webp] = await Promise.all([
		getImage({ src, widths: WIDTHS, format: 'avif', quality: 60 }),
		getImage({ src, widths: WIDTHS, format: 'webp', quality: 78 }),
	]);
	return { avif: avif.srcSet.attribute, webp: webp.srcSet.attribute, src: webp.src, sizes };
}

const images = {
	wall: await responsive(parede, '116vw'),
	shelf: await responsive(estante, PEOPLE_SIZES),
	man: await responsive(homem, PEOPLE_SIZES),
	woman: await responsive(mulher, PEOPLE_SIZES),
};
---

<Layout>
	<Fragment slot="head">
		<link rel="preload" as="image" type="image/avif" imagesrcset={images.wall.avif} imagesizes={images.wall.sizes} fetchpriority="high" />
		<link rel="preload" as="image" type="image/avif" imagesrcset={images.woman.avif} imagesizes={images.woman.sizes} fetchpriority="high" />
		<link rel="preload" as="image" type="image/avif" imagesrcset={images.man.avif} imagesizes={images.man.sizes} />
		<!-- o modelo 3D é usado já na tela de carregamento: começa a baixar junto com o HTML -->
		<link rel="preload" href={`${import.meta.env.BASE_URL}assets/logo-3d.glb`} as="fetch" crossorigin="anonymous" />
	</Fragment>

	<!-- Tela de carregamento: logo 3D se montando conforme o site carrega -->
	<Preloader />

	<!--
		1ª dobra — client:load
		Está na tela assim que a página abre: o parallax e a timeline de entrada
		precisam do JS imediatamente.
	-->
	<Hero client:load images={images} />

	<!--
		2ª dobra — client:load
		Exceção à regra "abaixo da dobra = client:visible": a cena 3D é a parte mais pesada
		do site (WebGL, modelo, shaders). Montá-la só ao aparecer travava a rolagem rápida.
		Agora ela é montada e aquecida DURANTE a tela de carregamento (que espera por ela),
		e o three.js/modelo já vêm do mesmo download da tela de carregamento.
		Enquanto não está na tela, ela não desenha nada (IntersectionObserver interno).
	-->
	<Dobra3D client:load />

	<!--
		3ª dobra — client:visible
		Folga POSITIVA de 1 tela: hidrata um pouco antes de entrar, para a cortina em curva
		já estar recortando a borda quando a seção surgir (senão apareceria um frame reto).
	-->
	<Metodo client:visible={{ rootMargin: '100% 0px 100% 0px' }} />

	<!--
		4ª dobra — client:visible
		Vídeos como credenciais de evento penduradas. Hidrata meia tela antes de aparecer,
		para a queda das credenciais começar no momento certo. Os vídeos completos (com som)
		só são baixados quando alguém abre o "modo palco".
	-->
	<Palco client:visible={{ rootMargin: '50% 0px 50% 0px' }} />
</Layout>
