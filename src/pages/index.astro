---
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Preloader from '../components/Preloader.astro';
import Hero from '../components/Hero.jsx';
import Dobra3D from '../components/Dobra3D.jsx';
import Metodo from '../components/Metodo.jsx';
import Palco from '../components/Palco.jsx';
import Bastidores from '../components/Bastidores.jsx';

import parede from '../assets/hero/parede.webp';
import estante from '../assets/hero/estante.webp';
import homem from '../assets/hero/homem.webp';
import mulher from '../assets/hero/mulher.webp';
import ladoALado from '../assets/bastidores/lado-a-lado.png';
import palestra from '../assets/bastidores/palestra.png';
import posicao from '../assets/bastidores/posicao.png';
import reuniao from '../assets/bastidores/reuniao.png';

/*
	Imagens da 1ª dobra geradas no build: AVIF (bem menor) com WebP de reserva,
	em 4 larguras — o celular baixa a pequena, a tela grande baixa a grande.
*/
const WIDTHS = [480, 768, 960, 1254];
const PEOPLE_SIZES = '(max-width: 900px) min(104vw, 560px), min(64vw, 112vh)';

async function responsive(src: ImageMetadata, sizes: string, widths = WIDTHS) {
	const [avif, webp] = await Promise.all([
		getImage({ src, widths, format: 'avif', quality: 60 }),
		getImage({ src, widths, format: 'webp', quality: 78 }),
	]);
	return { avif: avif.srcSet.attribute, webp: webp.srcSet.attribute, src: webp.src, sizes };
}

const images = {
	wall: await responsive(parede, '116vw'),
	shelf: await responsive(estante, PEOPLE_SIZES),
	man: await responsive(homem, PEOPLE_SIZES),
	woman: await responsive(mulher, PEOPLE_SIZES),
};

// fotos da 5ª dobra (polaroides): ocupam ~1/6 da tela no desktop e ~metade no celular
const PRINT_WIDTHS = [240, 360, 540];
const PRINT_SIZES = '(max-width: 900px) min(46vw, 250px), 17vw';
const prints = {
	ladoALado: await responsive(ladoALado, PRINT_SIZES, PRINT_WIDTHS),
	palestra: await responsive(palestra, PRINT_SIZES, PRINT_WIDTHS),
	posicao: await responsive(posicao, PRINT_SIZES, PRINT_WIDTHS),
	reuniao: await responsive(reuniao, PRINT_SIZES, PRINT_WIDTHS),
};
---

<Layout>
	<Fragment slot="head">
		<link rel="preload" as="image" type="image/avif" imagesrcset={images.wall.avif} imagesizes={images.wall.sizes} fetchpriority="high" />
		<link rel="preload" as="image" type="image/avif" imagesrcset={images.woman.avif} imagesizes={images.woman.sizes} fetchpriority="high" />
		<link rel="preload" as="image" type="image/avif" imagesrcset={images.man.avif} imagesizes={images.man.sizes} fetchpriority="high" />
		<!-- o modelo 3D NÃO entra aqui: ele é baixado depois da abertura (ver Dobra3D.jsx),
		     para não disputar banda com as imagens da 1ª dobra -->
	</Fragment>

	<!-- Tela de carregamento: logo 3D se montando conforme o site carrega -->
	<Preloader />

	<!--
		1ª dobra — client:load
		Está na tela assim que a página abre: o parallax e a timeline de entrada
		precisam do JS imediatamente.
	-->
	<Hero client:load images={images} />

	<!--
		2ª dobra — client:load
		O componente em si é minúsculo. O pesado (three.js + montagem e "aquecimento" da cena)
		só começa na primeira interação (mouse, rolagem, toque, teclado) — a abertura da página
		não executa nada de 3D, e a cena fica pronta antes de a pessoa chegar nela.
		O modelo .glb é baixado logo depois da abertura. Fora da tela, não desenha nada.
	-->
	<Dobra3D client:load />

	<!--
		3ª dobra — client:visible
		Folga POSITIVA de 1 tela: hidrata um pouco antes de entrar, para a cortina em curva
		já estar recortando a borda quando a seção surgir (senão apareceria um frame reto).
	-->
	<Metodo client:visible={{ rootMargin: '100% 0px 100% 0px' }} />

	<!--
		4ª dobra — client:visible
		Vídeos como credenciais de evento penduradas. Hidrata meia tela antes de aparecer,
		para a queda das credenciais começar no momento certo. Os vídeos completos (com som)
		só são baixados quando alguém abre o "modo palco".
	-->
	<Palco client:visible={{ rootMargin: '50% 0px 50% 0px' }} />

	<!--
		5ª dobra — client:visible
		Bastidores: polaroides numa mesa + o vídeo da Jornada tocando mudo, com as palavras do
		vídeo impressas na mesa em sincronia. Hidrata 1 tela antes, para a "lâmpada" já estar
		apagada quando a seção surgir. O vídeo com som só baixa ao clicar.
	-->
	<Bastidores client:visible={{ rootMargin: '100% 0px 100% 0px' }} images={prints} />
</Layout>
